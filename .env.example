# Slack credentials — from https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# YouTrack
YOUTRACK_URL=https://www.youtrackradteam.com:8443
YOUTRACK_TOKEN=perm:your-permanent-token

# Channel where YouTrack webhook notifications are posted
SLACK_YOUTRACK_CHANNEL=#youtrack-activity

# Otter.ai (enterprise API key)
OTTER_API_KEY=otterai_your_key_here

# Port for the inbound YouTrack webhook listener
WEBHOOK_PORT=5000
